From: Andrey Safonov <andrey.safonov@gmail.com>
Subject: [PATCH] phy: rockchip: reset PCIe PHY on probe after warm reboot

Source: anaelorlinski/OpenWrt-NanoPi-R2S-R4S-Builds,
07dd4528e285548cf3cf4dc5f9dfee17a5c21b69, openwrt-25.12/patches/
target/linux/rockchip/patches-6.12/402-1-rk3399-fix-pci-phy-reset-on-probe.patch.
Reset leftover lane/PHY state before training. Retain the separate upstream
lane power-on fix. Normalize whitespace only; no driver replacement.

Signed-off-by: Andrey Safonov <andrey.safonov@gmail.com>
--- a/drivers/phy/rockchip/phy-rockchip-pcie.c
+++ b/drivers/phy/rockchip/phy-rockchip-pcie.c
@@ -344,6 +344,20 @@
 
 MODULE_DEVICE_TABLE(of, rockchip_pcie_phy_dt_ids);
 
+static void rockchip_pcie_phy_reset(struct rockchip_pcie_phy *rk_phy)
+{
+	int i;
+
+	for (i = 0; i < PHY_MAX_LANE_NUM; i++)
+		regmap_write(rk_phy->reg_base,
+			     rk_phy->phy_data->pcie_laneoff,
+			     HIWORD_UPDATE(PHY_LANE_IDLE_OFF,
+					   PHY_LANE_IDLE_MASK,
+					   PHY_LANE_IDLE_A_SHIFT + i));
+
+	reset_control_assert(rk_phy->phy_rst);
+}
+
 static int rockchip_pcie_phy_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -393,6 +407,8 @@
 
 	phy_num = (phy_num == 0) ? 1 : PHY_MAX_LANE_NUM;
 	dev_dbg(dev, "phy number is %d\n", phy_num);
+
+	rockchip_pcie_phy_reset(rk_phy);
 
 	for (i = 0; i < phy_num; i++) {
 		rk_phy->phys[i].phy = devm_phy_create(dev, dev->of_node, &ops);

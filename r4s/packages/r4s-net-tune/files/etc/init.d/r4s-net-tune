#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# rc.common consumes these variables; BusyBox ash supports local.
# shellcheck disable=SC2034,SC3043
START=19
STOP=89
USE_PROCD=1

boot() {
	/usr/libexec/r4s-net-tune boot
	start
}

start_service() {
	local generation
	if [ -f /var/run/r4s-net-tune.installing ]; then
		rm -f /var/run/r4s-net-tune.installing
		return 0
	fi
	generation=$(/usr/libexec/r4s-net-tune activate) || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/r4s-net-tune watch "$generation"
	procd_set_param term_timeout 15
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	/usr/libexec/r4s-net-tune queue
}

stop_service() {
	/usr/libexec/r4s-net-tune stop
}

service_triggers() {
	procd_add_reload_trigger network firewall r4s_net_tune
	procd_add_raw_trigger 'interface.*' 1000 /etc/init.d/r4s-net-tune reload
	procd_add_raw_trigger 'firewall.*' 1000 /etc/init.d/r4s-net-tune reload
}
